---
import Layout from '@/layouts/Layout.astro'
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { formatDate, site } from '@/data/site'

export async function getStaticPaths() {
    const posts = await getCollection('posts')

    return posts.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }))
}

const { entry } = Astro.props
const { Content, headings } = await entry.render()
const words = entry.body.split(/\s+/).length
const minutes = Math.max(1, Math.round(words / 220))
const url = `${site.url}/blog/${entry.slug}/`
const shareText = encodeURIComponent(entry.data.title)
const shareUrl = encodeURIComponent(url)
const shareLinks = [
    {
        label: 'Share on X',
        icon: 'ri-twitter-x-line',
        href: `https://x.com/intent/post?text=${shareText}&url=${shareUrl}`,
    },
    {
        label: 'Share on LinkedIn',
        icon: 'ri-linkedin-box-line',
        href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
    },
    {
        label: 'Share on Facebook',
        icon: 'ri-facebook-circle-line',
        href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`,
    },
]
---

<Layout
    title={entry.data.title}
    description={entry.data.description}
    type="article"
    image={entry.data.image}
    imageAlt={entry.data.title}
    publishedDate={entry.data.publishedDate}
    updatedDate={entry.data.updatedDate}
    tags={entry.data.tags}
    noindex={!entry.data.publishedDate}
    breadcrumbs={[
        { name: 'Writing', path: '/blog/' },
        { name: entry.data.title, path: `/blog/${entry.slug}/` },
    ]}
    schema={[
        {
            '@type': 'BlogPosting',
            '@id': `${url}#article`,
            headline: entry.data.title,
            description: entry.data.description,
            url,
            mainEntityOfPage: url,
            ...(entry.data.image && {
                image: new URL(entry.data.image, site.url).href,
            }),
            ...(entry.data.publishedDate && {
                datePublished: entry.data.publishedDate.toISOString(),
                dateModified: (
                    entry.data.updatedDate ?? entry.data.publishedDate
                ).toISOString(),
            }),
            author: { '@id': `${site.url}/#person` },
            publisher: { '@id': `${site.url}/#person` },
            isPartOf: { '@id': `${site.url}/blog/#blog` },
            keywords: entry.data.tags?.join(', '),
            wordCount: words,
            timeRequired: `PT${minutes}M`,
            inLanguage: 'en',
        },
    ]}
>
    <article class="mx-auto w-[min(100%-2rem,48rem)] pt-16 sm:pt-24">
        <a
            href="/blog/"
            class="rise inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-fg"
        >
            <i class="ri-arrow-left-line"></i> All writing
        </a>

        <header class="mt-8">
            <p
                class="rise font-mono text-xs uppercase tracking-wider text-muted [animation-delay:60ms]"
            >
                {formatDate(entry.data.publishedDate) ?? 'Draft'} · {minutes} min
                read
            </p>
            <h1
                class="rise mt-4 text-balance text-4xl font-medium leading-[1.05] tracking-[-0.03em] [animation-delay:120ms] sm:text-6xl"
                transition:name={`blog-title-${entry.slug}`}
            >
                {entry.data.title}
            </h1>
            <p
                class="rise mt-5 text-pretty text-lg text-muted [animation-delay:180ms]"
            >
                {entry.data.description}
            </p>
            {
                entry.data.tags && (
                    <div class="rise mt-6 flex flex-wrap gap-1.5 [animation-delay:240ms]">
                        {entry.data.tags.map((tag) => (
                            <span class="chip py-0.5">#{tag}</span>
                        ))}
                    </div>
                )
            }
        </header>

        {
            entry.data.image && (
                <div class="mt-10 overflow-hidden rounded-3xl border border-line">
                    <Image
                        class="aspect-[16/9] w-full object-cover"
                        src={entry.data.image}
                        alt=""
                        height={540}
                        width={960}
                        transition:name={`blog-image-${entry.slug}`}
                    />
                </div>
            )
        }

        {
            headings.filter((h) => h.depth === 2).length > 2 && (
                <nav
                    aria-label="On this page"
                    class="card mt-10 p-5 text-sm"
                >
                    <p class="eyebrow">On this page</p>
                    <ol class="mt-3 grid gap-1.5 sm:grid-cols-2">
                        {headings
                            .filter((h) => h.depth === 2)
                            .map((h) => (
                                <li>
                                    <a
                                        href={`#${h.slug}`}
                                        class="text-muted transition-colors hover:text-fg"
                                    >
                                        {h.text}
                                    </a>
                                </li>
                            ))}
                    </ol>
                </nav>
            )
        }

        <div
            class="prose prose-zinc mt-12 max-w-none dark:prose-invert prose-headings:scroll-mt-28 prose-headings:font-medium prose-headings:tracking-tight prose-a:text-accent prose-a:underline-offset-4 prose-code:rounded-md prose-code:bg-fg/[0.08] prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-[0.85em] prose-code:font-normal prose-code:before:hidden prose-code:after:hidden prose-img:rounded-2xl"
        >
            <Content />
        </div>

        <footer
            class="mt-16 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between"
        >
            <p class="eyebrow">Share this post</p>
            <div class="flex items-center gap-1">
                {
                    shareLinks.map((l) => (
                        <a
                            href={l.href}
                            target="_blank"
                            rel="noopener"
                            aria-label={l.label}
                            title={l.label}
                            class="grid size-10 place-items-center rounded-full text-muted transition-colors hover:bg-fg/[0.07] hover:text-fg"
                        >
                            <i class={`${l.icon} text-lg`} />
                        </a>
                    ))
                }
                <button
                    type="button"
                    data-share
                    data-url={url}
                    data-title={entry.data.title}
                    class="btn-ghost ml-2 py-2"
                >
                    <i class="ri-link"></i>
                    <span>Copy link</span>
                </button>
            </div>
        </footer>
    </article>
</Layout>

<script>
    // Native share sheet on phones, copy-to-clipboard elsewhere
    document.addEventListener('astro:page-load', () => {
        const btn = document.querySelector<HTMLButtonElement>('[data-share]')
        if (!btn || btn.dataset.bound) return
        btn.dataset.bound = '1'
        const label = btn.querySelector('span')!
        const canShare =
            'share' in navigator && matchMedia('(pointer: coarse)').matches
        if (canShare) label.textContent = 'Share'

        btn.addEventListener('click', async () => {
            const { url = location.href, title = document.title } = btn.dataset
            try {
                if (canShare) {
                    await navigator.share({ title, url })
                    return
                }
                await navigator.clipboard.writeText(url)
                label.textContent = 'Copied!'
                setTimeout(() => (label.textContent = 'Copy link'), 2000)
            } catch {
                /* share sheet dismissed or clipboard blocked */
            }
        })
    })
</script>
