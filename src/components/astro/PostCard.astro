---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@/data/site'

interface Props {
    post: CollectionEntry<'posts'>
}

const { post } = Astro.props
---

<a
    href={`/blog/${post.slug}/`}
    class="reveal group grid gap-5 border-b border-line py-8 sm:grid-cols-[1fr_14rem] sm:items-center sm:gap-10"
>
    <div class="order-2 sm:order-1">
        <p class="font-mono text-xs uppercase tracking-wider text-muted">
            {formatDate(post.data.publishedDate) ?? 'Draft'}
        </p>
        <h2
            class="mt-3 text-balance text-2xl font-medium tracking-tight transition-colors group-hover:text-accent sm:text-3xl"
            transition:name={`blog-title-${post.slug}`}
        >
            {post.data.title}
        </h2>
        <p class="mt-3 max-w-xl text-pretty text-muted">
            {post.data.description}
        </p>
        {
            post.data.tags && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                    {post.data.tags.slice(0, 4).map((tag) => (
                        <span class="chip py-0.5">#{tag}</span>
                    ))}
                </div>
            )
        }
    </div>

    <div
        class="order-1 aspect-[16/10] overflow-hidden rounded-2xl border border-line bg-fg/5 sm:order-2"
    >
        <Image
            src={post.data.image || '/placeholder.svg'}
            alt=""
            height={280}
            width={448}
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            transition:name={`blog-image-${post.slug}`}
        />
    </div>
</a>
