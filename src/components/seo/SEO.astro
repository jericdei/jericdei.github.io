---
/**
 * All search-engine and social-sharing tags for a page:
 * canonical, Open Graph, Twitter/X cards, article metadata and JSON-LD.
 */
import { getCollection } from 'astro:content'
import { site } from '@/data/site'

export interface SEOProps {
    title: string
    description: string
    /** Absolute or root-relative image path; defaults to the site share card. */
    image?: string
    imageAlt?: string
    type?: 'website' | 'article' | 'profile'
    publishedDate?: Date | null
    updatedDate?: Date | null
    tags?: string[]
    noindex?: boolean
    /** Page-specific JSON-LD nodes, merged into the @graph. */
    schema?: Record<string, unknown>[]
    /** Breadcrumb trail (excluding Home) for sub-pages. */
    breadcrumbs?: { name: string; path: string }[]
}

const {
    title,
    description,
    image,
    imageAlt,
    type = 'website',
    publishedDate,
    updatedDate,
    tags = [],
    noindex = false,
    schema = [],
    breadcrumbs = [],
} = Astro.props as SEOProps

const canonical = new URL(Astro.url.pathname, site.url).href
const abs = (path: string) => new URL(path, site.url).href

const isDefaultImage = !image
const ogImage = abs(image ?? site.ogImage.src)
const ogAlt = imageAlt ?? (isDefaultImage ? site.ogImage.alt : title)

// Current role comes from the careers collection, so it never goes stale.
const careers = await getCollection('careers')
const current = careers.find((c) => c.data.date_to === null)?.data

const personId = `${site.url}/#person`
const websiteId = `${site.url}/#website`

const person = {
    '@type': 'Person',
    '@id': personId,
    name: site.name,
    url: `${site.url}/`,
    image: abs(site.ogImage.src),
    email: `mailto:${site.email}`,
    jobTitle: current?.position ?? site.role,
    ...(current && {
        worksFor: { '@type': 'Organization', name: current.company },
    }),
    alumniOf: { '@type': 'CollegeOrUniversity', name: site.education },
    address: {
        '@type': 'PostalAddress',
        addressLocality: site.city,
        addressCountry: site.countryCode,
    },
    sameAs: site.socials.map((s) => s.href),
    knowsAbout: [
        'TypeScript',
        'React',
        'Next.js',
        'Node.js',
        'Laravel',
        'PHP',
        'PostgreSQL',
        'Docker',
        'AWS',
    ],
}

const website = {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${site.url}/`,
    name: site.name,
    description: site.description,
    inLanguage: 'en',
    author: { '@id': personId },
    publisher: { '@id': personId },
}

const breadcrumbList =
    breadcrumbs.length > 0
        ? {
              '@type': 'BreadcrumbList',
              itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map(
                  (b, i) => ({
                      '@type': 'ListItem',
                      position: i + 1,
                      name: b.name,
                      item: abs(b.path),
                  }),
              ),
          }
        : null

const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [person, website, breadcrumbList, ...schema].filter(Boolean),
}
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<link rel="canonical" href={canonical} />
<meta
    name="robots"
    content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>

<!-- Open Graph (LinkedIn, Facebook, Slack, Discord, iMessage…) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogAlt} />
{
    isDefaultImage && (
        <>
            <meta property="og:image:width" content={String(site.ogImage.width)} />
            <meta property="og:image:height" content={String(site.ogImage.height)} />
            <meta property="og:image:type" content="image/png" />
        </>
    )
}
{
    type === 'profile' && (
        <>
            <meta property="profile:first_name" content="Jeric June" />
            <meta property="profile:last_name" content="Logan" />
            <meta property="profile:username" content="jericdei" />
        </>
    )
}
{
    type === 'article' && (
        <>
            {publishedDate && (
                <meta property="article:published_time" content={publishedDate.toISOString()} />
            )}
            {(updatedDate ?? publishedDate) && (
                <meta
                    property="article:modified_time"
                    content={(updatedDate ?? publishedDate)!.toISOString()}
                />
            )}
            <meta property="article:author" content={`${site.url}/`} />
            {tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
    )
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />

<!-- Feeds, sitemap, manifest -->
<link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="manifest" href="/site.webmanifest" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
