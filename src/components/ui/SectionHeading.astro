---
interface Props {
    eyebrow: string
    title: string
    accent?: string
    id?: string
}

const { eyebrow, title, accent, id } = Astro.props
---

<div class="reveal flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2
            id={id}
            class="mt-3 text-balance text-3xl font-medium tracking-tight sm:text-5xl"
        >
            {title}
            {accent && <span class="font-serif italic text-accent">{accent}</span>}
        </h2>
    </div>
    <slot />
</div>
